{
  "mcpServers": {
    "runway": {
      "command": "node",
      "args": ["vendor/runway-api-mcp-server/build/index.js"],
      "env": {
        "RUNWAYML_API_SECRET": "${RUNWAYML_API_SECRET}",
        "MCP_TOOL_TIMEOUT": "1000000"
      }
    },
    "higgsfield": {
      "type": "http",
      "url": "https://mcp.higgsfield.ai/mcp"
    }
  }
}
