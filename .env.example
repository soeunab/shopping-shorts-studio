# 채널 카테고리 (제품 선정 기준 4번)
SSS_CATEGORY=주방·살림

# 무료 AI 음성: google(기본) | say(맥 기본 음성)
SSS_TTS=google
# Google Cloud Text-to-Speech API 키 (README '무료 음성')
GOOGLE_TTS_API_KEY=
# SSS_TTS_VOICE=ko-KR-Neural2-A
# SSS_SPEED=1.1
# SSS_VOICE=Yuna (Premium)      # say 음성을 직접 지정할 때

# Pexels 무료 스톡 영상 API 키 (https://www.pexels.com/api/)
PEXELS_API_KEY=

# 유튜브 수익창출 조건 (유튜브 고객센터에서 확인한 값을 넣으면 report 에 진행률 표시)
# SSS_YPP_SUBS=
# SSS_YPP_SHORTS_VIEWS=

# 선택
# SSS_DATA=data                 # DB·영상 저장 위치
# SSS_EXPORT_DIR=               # 내보내기 위치(예: ~/Library/Mobile Documents/com~apple~CloudDocs/쇼츠)
# SSS_FONT=Apple SD Gothic Neo  # 자막 글꼴
# CLAUDE_CODE_MODEL=sonnet

# (선택) 유튜브 API 업로드용 OAuth — 구글 클라우드 콘솔 → OAuth 클라이언트 ID → 데스크톱 앱
# YT_CLIENT_ID=
# YT_CLIENT_SECRET=
