# 채널 카테고리 (제품 선정 기준 4번)
SSS_CATEGORY=주방·살림

# 무료 AI 음성: google(기본) | say(맥 기본 음성)
SSS_TTS=google
# Google Cloud Text-to-Speech API 키 (README '무료 음성')
GOOGLE_TTS_API_KEY=
# SSS_TTS_VOICE=ko-KR-Neural2-A
# SSS_SPEED=1.1
# SSS_VOICE=Yuna (Premium)      # say 음성을 직접 지정할 때

# Pexels 무료 스톡 영상 API 키 (https://www.pexels.com/api/)
PEXELS_API_KEY=

# 네이버 검색광고 API (keywords 명령: 월간 검색량) — jk-biz 와 같은 값, searchad.naver.com → 도구 → API 사용 관리
NAVER_AD_API_KEY=
NAVER_AD_SECRET_KEY=
NAVER_AD_CUSTOMER_ID=

# Runway AI 영상 (유료 개발자 크레딧, https://dev.runwayml.com)
# ai-clip 명령용. Runway MCP(Claude Code)는 이 값이 아니라 셸 환경변수 RUNWAYML_API_SECRET 를 읽습니다.
RUNWAYML_API_SECRET=
# SSS_RUNWAY_I2V_MODEL=gen4_turbo     # 상품 이미지→영상 (5크레딧/초)
# SSS_RUNWAY_T2V_MODEL=gen4.5         # 상황 장면 텍스트→영상 (12크레딧/초)
# SSS_CONTEXT_PROMPT=bright tidy home kitchen, lifestyle b-roll, no products in focus

# 유튜브 수익창출 조건 (유튜브 고객센터에서 확인한 값을 넣으면 report 에 진행률 표시)
# SSS_YPP_SUBS=
# SSS_YPP_SHORTS_VIEWS=

# 선택
# SSS_DATA=data                 # DB·영상 저장 위치
# SSS_EXPORT_DIR=               # 내보내기 위치(예: ~/Library/Mobile Documents/com~apple~CloudDocs/쇼츠)
# SSS_FONT=Apple SD Gothic Neo  # 자막 글꼴
# CLAUDE_CODE_MODEL=sonnet

# (선택) 유튜브 API 업로드용 OAuth — 구글 클라우드 콘솔 → OAuth 클라이언트 ID → 데스크톱 앱
# YT_CLIENT_ID=
# YT_CLIENT_SECRET=
